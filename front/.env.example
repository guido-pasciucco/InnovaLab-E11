# Use mock responses until the backend team publishes the agreed API.
# /api goes through the Vite dev proxy to the backend at http://localhost:8000.
VITE_API_BASE_URL=/api
VITE_USE_MOCK_API=true
# Address search already exists in the backend (GET /geolocation/addresses).
# Set to false to use it while the rest of the API stays mocked. Defaults to VITE_USE_MOCK_API.
VITE_USE_MOCK_ADDRESS_SEARCH=true
