# Plantilla de variables de entorno del backend. Copiar a .env y ajustar.
# Contiene ejemplos, nunca secretos reales.

# Orígenes que pueden llamar a la API desde el navegador (lista en formato JSON).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Georef (Gobierno Nacional): normalización y geocodificación de direcciones.
GEOREF_BASE_URL=https://apis.datos.gob.ar/georef/api
GEOREF_TIMEOUT_SECONDS=10

# Postgres con pgvector (por defecto, el Supabase local de back/supabase).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
DATABASE_POOL_TIMEOUT_SECONDS=10

# Embeddings para la búsqueda de actividades. Por defecto, Cloudflare Workers AI
# (modelo @cf/baai/bge-m3). Token con permisos Workers AI Read+Edit
# (dashboard de Cloudflare, plantilla "Create a Workers AI API Token").
EMBEDDING_PROVIDER=cloudflare
EMBEDDING_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Modelo servido por Workers AI (por defecto el de arriba).
# CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-m3

# Alternativa local (solo con la columna vector(384) de antes de la migración 20261113000000):
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
